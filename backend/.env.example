# Backend - variaveis de ambiente (copie para .env e preencha)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
REDIS_URL=""
# Frontend (usado no redirect do Stripe e no gate de depósitos)
FRONTEND_URL="http://localhost:3000"
# Stripe (depósito em conta) — checkouts e webhook
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# RAG embeddings (vetorial 768d) — Gemini free ou OpenAI text-embedding-3-small
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# LLM (chat/briefings) — Groq é o provider padrão; OpenAI é fallback
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_MODEL="gpt-4o-mini"